# EasyMail environment template (Phase 8)
# Copy to `.env.local` for local development. Never commit real secrets.

# --- App ---
NODE_ENV=development
# local | staging | production
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server only) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres URL for local RLS tests / migrations tooling
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Token encryption (AES-256-GCM) ---
# 32-byte key, base64-encoded (generate locally; never commit real value)
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Google OAuth (mailbox linking; read-only gmail.readonly) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# --- Microsoft OAuth (mailbox linking; Mail.Read) ---
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/oauth/microsoft/callback
MICROSOFT_TENANT_ID=common

# --- AI Gateway (classification) ---
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
# Optional pin; choose at implementation (Phase 10+)
# AI_CLASSIFY_MODEL=provider/model

# --- Optional: RLS test flags ---
# Set to 1 to force-run RLS tests; leave unset to auto-skip when Supabase is down
# RUN_RLS_TESTS=1

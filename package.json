{
  "name": "easymail",
  "version": "0.1.0",
  "private": true,
  "description": "EasyMail — cross-inbox attention layer for Gmail and Outlook",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests vitest.config.mts eslint.config.mjs next.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:rls": "vitest run --project rls",
    "verify:phase9": "node scripts/verify-phase9.mjs",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "seed:phase10-demo": "node --env-file=.env.local scripts/seed-phase10-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeronM18/EasyMail.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/MeronM18/EasyMail/issues"
  },
  "homepage": "https://github.com/MeronM18/EasyMail#readme",
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^6.0.280",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
